<?xml version="1.0" encoding="utf-8"?>
<!-- YewPlay: the icon of the Android 12+ splash screen. The system shows it in a 288dp area cut
     to a 192dp circle, so the rounded square (112dp) is placed in the middle, uncut. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:width="288dp"
        android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <item
        android:width="112dp"
        android:height="112dp"
        android:drawable="@drawable/ic_yewplay_logo"
        android:gravity="center" />
</layer-list>
